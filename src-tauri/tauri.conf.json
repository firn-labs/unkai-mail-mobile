{
  "$schema": "node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Unkai Mail",
  "version": "0.1.0",
  "identifier": "com.unkai.mail",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Unkai Mail",
        "width": 430,
        "height": 932,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Firn Labs",
    "copyright": "\u00a9 2026 Firn Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "frameworks": [
        "SystemConfiguration",
        "Contacts",
        "EventKit"
      ]
    }
  },
  "plugins": {}
}
